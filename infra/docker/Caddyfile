{
	# ACME email: only used when origins are https://... (Caddy auto-provisions certs).
	# For plain http:// local dev the value is ignored but must be non-empty,
	# otherwise Caddy rejects the bare `email` directive.
	# compose.yml injects a default (SWIZZLE_ACME_EMAIL:-none@invalid.local);
	# the inline `:none@invalid.local` fallback here is belt-and-suspenders so
	# the template also boots standalone if someone runs Caddy directly without
	# compose and forgets to export the variable.
	email {$SWIZZLE_ACME_EMAIL:none@invalid.local}

	# SWIZZLE_LINK_TRUSTED_PROXY names the proxies, such as a tunnel on the server, whose
	# X-Forwarded-For Caddy passes on with the peer appended. From any other peer Caddy replaces the
	# header, and the default trusts none. The API takes the rightmost address that is not a private
	# hop, so a value a client put in front does not count. The dashboard and the API sites below
	# overwrite the header with the TCP peer, so the trust reaches only the links origin.
	servers {
		trusted_proxies static {$SWIZZLE_LINK_TRUSTED_PROXY}
	}
}

# Dashboard (web), at SWIZZLE_DASHBOARD_SITE, which defaults to SWIZZLE_DASHBOARD_ORIGIN. Set the
# origin to https://... for auto-TLS. Behind tailscale serve, which answers the origin over HTTPS,
# the site is http://<the same name>:<SWIZZLE_HTTP_PORT>, the port tailscale serve forwards to.
# Also routes /api/* to the API service so local/single-origin deployments work
# without a second hostname.
# SWIZZLE_PRIVATE_RANGES lists the client addresses the dashboard and the API answer; every other
# client gets a bare 404 there. The default answers everyone. Narrow it, for example to
# `private_ranges 100.64.0.0/10` (local networks and Tailscale), when only the links origin below
# may be public.

{$SWIZZLE_DASHBOARD_SITE} {
	encode zstd gzip

	# `?` on Content-Security-Policy here and on the API site sets it only where the upstream set
	# none. The dashboard's static server sets none, so its pages get this one. The API sets its own
	# on every answer, which the approval page and the OAuth callback page need: the approval page
	# allows its one script by hash (apps/api/src/approval-page.ts), and it is reachable through
	# /api/* here, the API site and the links origin alike.
	header {
		?Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' {$SWIZZLE_API_ORIGIN}; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	route {
		@outside not remote_ip {$SWIZZLE_PRIVATE_RANGES:0.0.0.0/0 ::/0}
		respond @outside 404
		handle_path /api/* {
			reverse_proxy api:19820 {
				header_up X-Forwarded-For {remote_host}
			}
		}
		handle {
			reverse_proxy web:4173
		}
	}
}

# API (REST + webhooks). The site defaults to SWIZZLE_API_ORIGIN. Behind a tunnel it
# listens locally while the public API base includes the dashboard's /api proxy path.
{$SWIZZLE_API_SITE} {
	encode zstd gzip

	header {
		?Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; style-src 'unsafe-inline'"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		-Server
	}

	route {
		@outside not remote_ip {$SWIZZLE_PRIVATE_RANGES:0.0.0.0/0 ::/0}
		respond @outside 404
		reverse_proxy api:19820 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# Approval pages and event callbacks, and nothing else: the origin to expose to the internet when
# the dashboard and the API stay private. Approval and event links start with it unless
# SWIZZLE_LINK_URL names a tunnel in front of it, such as Tailscale Funnel. Every other path is a
# bare 404. Tunnels forward to the separate HTTP listener, whose routes never depend on Host.
{$SWIZZLE_LINK_ORIGIN}, http://:{$SWIZZLE_LINK_PORT:19828} {
	encode zstd gzip

	# `?` keeps the API's own policy: the approval page allows its one script by hash
	# (apps/api/src/approval-page.ts). Caddy's own 404 still gets this one.
	header {
		?Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; style-src 'unsafe-inline'"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@links path /approvals/* /events/*
	handle @links {
		reverse_proxy api:19820
	}
	handle {
		respond 404
	}
}
