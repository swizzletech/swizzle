{
  "name": "@swizzle/core",
  "version": "1.3.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "swizzle-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./dev-port": {
      "swizzle-source": "./src/dev-port.ts",
      "default": "./src/dev-port.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "import-in-the-middle": "^3.5.3",
    "nodemailer": "^10.6.1",
    "pino": "catalog:",
    "pino-roll": "^4.0.0",
    "thread-stream": "^4.2.1",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
