# Configuration of the packaged stack: `just stack`, `just backup`, `just restore`.
# The dev stack (`just dev`, `just dev-fresh`) does not read this file; its secrets live in
# ~/.config/swizzle/dev.env (see scripts/dev-stack.mts).

# Compose project of this stack: its containers, networks and volumes carry this name.
# `just setup` writes it with the credentials below, so every checkout's stack keeps its own
# volumes and they never meet another .env's passwords.
COMPOSE_PROJECT_NAME=
# conventions-allow env-example-reaches-compose: compose sets NODE_ENV=production for every service.
NODE_ENV=development
LOG_LEVEL=info

# --- Runtime ---
# Source: packages/config/src/schema.ts
# Defaults are convenient for local Docker Compose. For a public deployment:
#   • generate the database, Valkey, setup, and encryption secrets below.
POSTGRES_USER=swizzle
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
# One revocable identity for the packaged local worker. Remote workers use owner enrollment.
SWIZZLE_LOCAL_WORKER_TOKEN=
# Per-host grant control. just setup generates it. Keep it out of automations.
SWIZZLE_LOCAL_LLM_CONTROL_TOKEN=
# Optional named local LLM upstream. Use an authenticated server at a literal IP and exact port.
SWIZZLE_LOCAL_LLM_UPSTREAM=
SWIZZLE_LOCAL_LLM_API_KEY=
SWIZZLE_LOCAL_LLM_MODEL=
SWIZZLE_LOCAL_LLM_CONCURRENCY=2
SWIZZLE_LOCAL_LLM_REQUESTS=10
SWIZZLE_LOCAL_LLM_MAX_TOKENS=512
SCHEDULER_INTERVAL_MS=15000
SCHEDULER_MAINTENANCE_INTERVAL_MS=60000
# Default control-plane namespace. The dashboard supports exactly staging and
# production; fresh installations start in production. This selects the default,
# while the scheduler serves both environments.
SWIZZLE_ENVIRONMENT=production

# --- Public origins (used by Caddy + compiled into the web dashboard) ---
# Source: infra/docker/Caddyfile, infra/docker/compose.yml
# Defaults use non-privileged ports in the Swizzle range (19826/19827) to
# avoid collisions with VPN/1Password/WARP on 443 and sudo requirements on 80.
# Browsers resolve *.localhost to 127.0.0.1 automatically — no DNS setup needed.
#
# The port in the origin MUST match SWIZZLE_HTTP_PORT / SWIZZLE_HTTPS_PORT:
# Caddy listens internally on the port specified in the origin, and compose
# maps the same host port to the same container port (symmetric).
#
# Examples (production HTTPS — requires ports 80/443 reachable from the internet):
#   SWIZZLE_DASHBOARD_ORIGIN=https://swizzle.example.com
#   SWIZZLE_API_ORIGIN=https://api.swizzle.example.com
#   SWIZZLE_ACME_EMAIL=ops@example.com
#   SWIZZLE_HTTP_BIND=0.0.0.0
#   SWIZZLE_HTTP_PORT=80
#   SWIZZLE_HTTPS_PORT=443
SWIZZLE_DASHBOARD_ORIGIN=http://localhost:19826
SWIZZLE_API_ORIGIN=http://api.localhost:19826
SWIZZLE_ACME_EMAIL=
# Where Caddy serves the dashboard; empty means SWIZZLE_DASHBOARD_ORIGIN. Set it only when a proxy
# on this host answers the origin over HTTPS and forwards to Caddy, as tailscale serve does:
#   SWIZZLE_DASHBOARD_ORIGIN=https://server.example-tailnet.ts.net
#   SWIZZLE_DASHBOARD_SITE=http://server.example-tailnet.ts.net:19826
#   SWIZZLE_API_ORIGIN=https://server.example-tailnet.ts.net/api
#   SWIZZLE_API_SITE=http://api.localhost:19826
SWIZZLE_DASHBOARD_SITE=
# Where Caddy serves the API; empty means SWIZZLE_API_ORIGIN. With tailscale serve, keep
# this on HTTP locally and set SWIZZLE_API_ORIGIN to the HTTPS dashboard address plus /api.
SWIZZLE_API_SITE=

# --- Caddy host port mapping (only used by compose.yml stack profile) ---
# Override for production (80/443). Dev defaults avoid port conflicts on
# typical macOS dev machines where 443 is held by VPN or password-manager
# extensions. If you change these, also update the port in the origins above.
# Both HTTP and HTTPS use this IPv4 bind. Keep 127.0.0.1 for local access and tunnels;
# set 0.0.0.0 for public IPv4 access. IPv6 publishing would hide peers behind Docker's private
# gateway and bypass SWIZZLE_PRIVATE_RANGES. Do not use an IPv6 bind.
SWIZZLE_HTTP_BIND=127.0.0.1
SWIZZLE_HTTP_PORT=19826
SWIZZLE_HTTPS_PORT=19827
# Links-only HTTP listener for tunnels, always published on 127.0.0.1. Keep its port distinct
# from SWIZZLE_HTTP_PORT and SWIZZLE_HTTPS_PORT. Never forward a public tunnel to those ports.
SWIZZLE_LINK_PORT=19828

# --- CORS ---
# Source: apps/api/src/http-shared.ts (getAllowedOrigins)
# Leave empty to allow only SWIZZLE_DASHBOARD_ORIGIN; without either the API allows no
# cross-origin request. For multi-origin setups (e.g. staging + prod) set a comma-separated list.
SWIZZLE_CORS_ORIGINS=

# --- OAuth connections (public callback URL) ---
# Source: apps/api/src/http-shared.ts (publicApiUrl), apps/api/src/connection-routes.ts
# Public base URL of the API, used to build the OAuth redirect_uri
# (${SWIZZLE_PUBLIC_URL}/oauth/callback/<provider>) that you register with each
# provider (e.g. the Google Cloud console). Must be the externally reachable
# base URL, including a proxy path such as /api.
# When unset, the API only derives it from the request for localhost; any other
# host fails authorize with CONNECTION_PUBLIC_URL_NOT_CONFIGURED. Compose
# defaults this to SWIZZLE_API_ORIGIN; override only when the callback base differs.
# The API builds /hooks/ webhook URLs that apply, inspect and the dashboard show
# from it, path included (${SWIZZLE_PUBLIC_URL}<trigger.path>). Root-path webhooks
# use SWIZZLE_API_ORIGIN, which serves them on private installs. When unset
# they are shown only on localhost. On a private instance whose public listener
# a tunnel publishes, set it to the tunnel's address (docs/how-to/install.md).
SWIZZLE_PUBLIC_URL=

# --- Approval and event links ---
# Source: infra/docker/Caddyfile, packages/runtime/src/wait-links.ts
# Caddy serves only /approvals/* and /events/* on SWIZZLE_LINK_ORIGIN, so it can be public while
# the dashboard and the API stay private. Links start with SWIZZLE_LINK_URL, which defaults to
# SWIZZLE_LINK_ORIGIN. For a tunnel, set its public HTTPS URL here and forward the tunnel to
# 127.0.0.1:SWIZZLE_LINK_PORT. Non-local plain-HTTP link URLs fail production API startup.
# SWIZZLE_PRIVATE_RANGES lists the client addresses the dashboard and the API answer (Caddy
# remote_ip syntax); every other client gets 404 there. Empty answers everyone.
# Example (dashboard and API on the tailnet, links public):
#   SWIZZLE_LINK_ORIGIN=https://approve.example.com
#   SWIZZLE_PRIVATE_RANGES=private_ranges 100.64.0.0/10
SWIZZLE_LINK_ORIGIN=
SWIZZLE_LINK_URL=
SWIZZLE_PRIVATE_RANGES=
# SWIZZLE_LINK_TRUSTED_PROXY names the address a tunnel on the server connects to Caddy from: the
# gateway of the stack's outbound network. Caddy then believes the tunnel's X-Forwarded-For on the
# public listener, so each sender and link holder gets their own webhook, approval and event
# budget. Empty trusts no proxy.
# Set it only when the tunnel is the only way from the internet to Caddy's ports.
SWIZZLE_LINK_TRUSTED_PROXY=
# The approval and event-callback budgets per client address (apps/api/src/approval-routes.ts,
# apps/api/src/event-callback-routes.ts).
SWIZZLE_APPROVAL_RATE_LIMIT=30/min
SWIZZLE_EVENT_CALLBACK_RATE_LIMIT=60/min
# Production API/worker HTTP requests are routed through the bundled Squid
# service, which rejects loopback, private, link-local, metadata, and reserved
# destinations. Compose sets this automatically; set an equivalent proxy when
# running production services outside the packaged stack.
# conventions-allow env-example-reaches-compose: compose points every service at its bundled proxy.
# SWIZZLE_CONTROL_EGRESS_PROXY=http://runner-egress-proxy:3128
# Plain HTTP custom-OAuth endpoints are rejected. This escape hatch is only for
# an isolated local provider and must never be enabled on a public instance.
# conventions-allow env-example-reaches-compose: only an isolated local provider needs it, never the packaged stack.
# SWIZZLE_ALLOW_INSECURE_OAUTH_ENDPOINTS=false

# --- Artifact storage ---
# Source: packages/runtime/src/storage.ts
# Artifact storage backend: local (shared volume) or s3 (an external S3-compatible
# service such as AWS S3 or Cloudflare R2; the stack bundles no S3 server). The api
# and worker reach the endpoint through the egress proxy, which refuses private
# addresses, so it needs a public address.
SWIZZLE_ARTIFACT_BACKEND=local
# Used when SWIZZLE_ARTIFACT_BACKEND=local
# conventions-allow env-example-reaches-compose: compose mounts the artifact volume at a fixed path.
SWIZZLE_ARTIFACTS_DIR=.swizzle/artifacts
# Used when SWIZZLE_ARTIFACT_BACKEND=s3
SWIZZLE_ARTIFACT_S3_BUCKET=swizzle-artifacts
# Leave empty for AWS S3; set the provider's URL otherwise.
SWIZZLE_ARTIFACT_S3_ENDPOINT=
SWIZZLE_ARTIFACT_S3_FORCE_PATH_STYLE=true
SWIZZLE_ARTIFACT_S3_PREFIX=artifacts
SWIZZLE_ARTIFACT_S3_REGION=us-east-1
# Standard AWS-compatible credentials for the S3 backend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Secrets ---
# Source: packages/db/src/secrets.ts
# Required for platform secret CRUD and runtime secret injection.
# The full Compose profile refuses to start when this variable is missing.
# Generate a fresh key per environment — re-using the same value across
# deployments lets an attacker with DB access decrypt every environment.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (or `openssl rand -base64 32`). API and worker must share the same value.
SWIZZLE_ENCRYPTION_KEY=replace-with-32-raw-bytes-or-base64-32-byte-key
# Rotation window only: JSON array of prior 32-byte keys that stay decrypt-only
# until every stored credential is re-encrypted. Keep [] during normal operation.
SWIZZLE_ENCRYPTION_PREVIOUS_KEYS=[]

# --- First-owner bootstrap ---
# Required by production API startup on every non-loopback bind. This prevents
# the first remote visitor from claiming a freshly deployed instance. Generate
# a different token from the encryption key, enter it once on the setup screen,
# then keep it in the server-side environment for restart-safe fail-closed boot.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SWIZZLE_SETUP_TOKEN=

# --- Mail ---
# Source: packages/core/src/mail.ts
# Invitations and password resets go out by mail. Without a server, an owner or
# admin copies invitation and reset links from Settings > People and passes them on,
# and a locked-out owner runs `just recover-owner` on the host. smtp:// upgrades with STARTTLS
# and refuses a server that offers none; smtps:// is TLS from the first byte.
# Credentials go in the URL, percent-encoded: smtps://user:p%40ss@mail.example.com:465
# The API reaches the server through the control egress proxy, which allows 465 and 587.
SWIZZLE_SMTP_URL=
# The sender of every mail, such as: Swizzle <swizzle@example.com>
SWIZZLE_MAIL_FROM=

# --- API auth ---
# Source: apps/api/src/auth-routes.ts
# Set this to true when TLS terminates before the API and the proxy does not pass
# X-Forwarded-Proto: https. Leave unset when Caddy supplies the forwarded scheme.
# SWIZZLE_AUTH_COOKIE_SECURE=true

# --- Public webhook ingress ---
# Source: apps/api/src/server.ts, apps/api/src/webhook-ingress.ts
# Per API-process guard applied before webhook trigger lookup / run creation.
# The budget is per client IP (not per path), so scanning many webhook paths from
# one source cannot bypass it. Format matches runtime rate-limit specs such as
# 60/min or 1000/hour. Set to false/off/disabled/0 only behind a trusted upstream
# limiter.
SWIZZLE_WEBHOOK_INGRESS_RATE_LIMIT=60/min

# Which upstream proxies the API may trust for the client IP (X-Forwarded-For).
# Leave UNSET for direct exposure: the real socket address is used and cannot be
# spoofed. Behind a reverse proxy (e.g. Caddy) the socket address is the proxy, so
# WITHOUT this every client shares one rate-limit bucket — set it to the proxy so
# Fastify derives the real client IP spoof-resistantly. Accepts an IP/CIDR list
# (e.g. 127.0.0.1,::1 or 10.0.0.0/8) or a proxy-addr preset (loopback, linklocal,
# uniquelocal). `true` trusts every proxy and a hop count such as 1 reads as an
# address; production rejects both.
# SWIZZLE_TRUSTED_PROXY=10.0.0.0/8

# --- Retention ---
# Source: packages/db/src/control-plane.ts
SWIZZLE_NOTIFICATION_DELIVERY_RETENTION_DAYS=30
SWIZZLE_QUEUE_METRIC_RETENTION_DAYS=14
# How long decommissioned worker/scheduler heartbeats linger in dashboard_services
# before the maintenance job deletes them. Short retention keeps the services
# table lean; raise this if you want more audit history for incident reviews.
SWIZZLE_HEARTBEAT_RETENTION_HOURS=6
# How long failed BullMQ jobs linger in Valkey before the maintenance job
# prunes them. Without pruning, a single stale failure pins the dashboard to
# `state: degraded — queue-pressure` forever. Keep this high enough that an
# operator has time to investigate; 24h is a sensible default.
SWIZZLE_QUEUE_FAILED_RETENTION_HOURS=24
# Days a finished run is kept, with its attempts, logs and step values, after it
# finished. Queued, running and waiting runs never expire. Defaults to 30; set 0
# or off to keep runs indefinitely. Audit events are kept regardless.
SWIZZLE_RUN_RETENTION_DAYS=30

# --- Worker sizing ---
# Source: packages/core/src/worker-settings.ts and packages/db/src/local-worker.ts
# One configured local identity. The server enforces this capacity across all its profiles.
# Start with 1 on a small VPS, 2 on four cores, or 4 on eight cores as memory permits.
# Additional machines enroll separately, each with explicit grants and capacity.
WORKER_CONCURRENCY=
# Scheduler IDs must remain unique per live scheduler process.
SWIZZLE_SCHEDULER_INSTANCE_ID=scheduler-1
# Maximum allowed runtime.timeout for any deployed or local run.
# Operators can raise this intentionally, but long runs occupy worker slots.
SWIZZLE_MAX_RUN_TIMEOUT=1h
# Maximum runtime.container.memory_mb (MiB) and cpus an automation may ask for.
# Each run, and its dependency install, gets what it asks for (default 512 MiB
# and 1 CPU); a deploy above either maximum fails. Keep the maximum times
# WORKER_CONCURRENCY within what the host can spare.
SWIZZLE_MAX_RUN_MEMORY_MB=2048
# CPUs of the worker process, and the most CPUs one run may ask for. Docker refuses a
# limit above the host's CPU count, so `just init-env` writes 2 here, or the host's
# count when that is smaller, and fails when a value you set exceeds the host.
SWIZZLE_WORKER_CPUS=
SWIZZLE_MAX_RUN_CPUS=
# Maximum MiB a dependency install may write to its container (the copied source
# included). The worker kills an install that passes it.
SWIZZLE_MAX_INSTALL_DISK_MB=4096
# Drain timeout of the API and scheduler before forcing shutdown on SIGTERM/SIGINT (ms).
# Keep their stop_grace_period in infra/docker/compose.yml longer than this timeout.
# The worker's drain is fixed in infra/docker/execution.yml, beside its stop grace.
SWIZZLE_SHUTDOWN_TIMEOUT_MS=30000
# The worker keeps the run images of active deployments and prunes this stack's
# other run images (labelled swizzle.stack=<COMPOSE_PROJECT_NAME>): those older
# than the retention window, and the oldest ones beyond the disk budget in MiB.
# Active deployments' images and images assembled in the last ten minutes count
# first and are never removed for the budget.
# Other stacks on the host keep theirs.
# Extra Debian package names for deployed runs, separated by spaces. Kept through upgrades.
SWIZZLE_RUNNER_APT_PACKAGES=
SWIZZLE_RUNNER_IMAGE_RETENTION_HOURS=24
SWIZZLE_RUNNER_IMAGE_DISK_MB=20480

# --- CLI defaults ---
# Source: apps/cli/src/api.ts
# Where the CLI sends API requests when no profile / --api-url is set.
# Default matches the Caddy stack ('docker compose --profile stack up').
# For the dev stack (`just dev`), use the api URL it prints.
# conventions-allow env-example-reaches-compose: the CLI reads it on the host.
SWIZZLE_API_URL=http://api.localhost:19826

# --- Observability ---
# Source: packages/core/src/tracing.ts, docs/how-to/enable-tracing.md
# When set, api/scheduler/worker start the OpenTelemetry SDK and export
# traces via OTLP/HTTP to <endpoint>/v1/traces. Leave empty to disable tracing.
# The api and worker reach it through the egress proxy, which refuses private
# addresses, so the collector needs a public address. Example: https://otlp.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# The packaged worker uses a dedicated named volume for /home/swizzle. It
# deliberately cannot mount the operator's real home directory. Agent CLIs must
# receive credentials through declared Swizzle secrets/connections instead of
# inheriting SSH keys, cloud profiles, or personal dotfiles from the host.
