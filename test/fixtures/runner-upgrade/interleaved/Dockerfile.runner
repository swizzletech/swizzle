ARG RUNNER_BASE=scratch
ARG WORKER_BASE=scratch
FROM ${RUNNER_BASE} AS runner
ARG SWIZZLE_RUNNER_APT_PACKAGES
COPY --link --chmod=0644 ${SWIZZLE_RUNNER_APT_PACKAGES}-${FIXTURE_RELEASE}.json /etc/swizzle/runner-tools.json

FROM ${WORKER_BASE} AS worker
COPY --link --from=runner /etc/swizzle/runner-tools.json /etc/swizzle/runner-tools.json
