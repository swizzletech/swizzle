FROM scratch AS runner-base
ARG VERSION
ARG SWIZZLE_DOCKER_TEST_RUN
LABEL fixture.release=$VERSION swizzle.test.run=$SWIZZLE_DOCKER_TEST_RUN
ENV FIXTURE_RELEASE=$VERSION

FROM scratch AS worker
ARG VERSION
ARG SWIZZLE_DOCKER_TEST_RUN
LABEL fixture.release=$VERSION swizzle.test.run=$SWIZZLE_DOCKER_TEST_RUN
USER 10001:10001
