// Writes the reference pages under docs/reference from the code they describe:
// the config contract from packages/config, the CLI from apps/cli, the API routes from apps/api.
// `just gen` writes the pages; `just docs-check` runs this with --check and fails on a stale page.
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { createProgram, describeCommandTree, describeOption } from "@swizzle/cli";
import {
  AUTOMATION_CONFIG_DECLARATIVE_FIELDS,
  createAutomationConfigJsonSchema,
} from "@swizzle/config";
import { ROUTE_ACCESS, WEBHOOK_PATH_PREFIX } from "@swizzle/runtime/http-contract";
import { WORKER_ROUTES } from "@swizzle/runtime/platform";
import ts from "typescript";

const repoRoot = path.resolve(fileURLToPath(new URL(".", import.meta.url)), "..");

interface ReferencePage {
  readonly file: string;
  readonly render: () => string;
}

const pages: readonly ReferencePage[] = [
  { file: "docs/reference/config.md", render: renderConfigReference },
  { file: "docs/reference/cli.md", render: renderCliReference },
  { file: "docs/reference/api.md", render: renderApiReference },
];

function main(): void {
  const check = process.argv.includes("--check");
  const stale: string[] = [];
  for (const page of pages) {
    const absolute = path.join(repoRoot, page.file);
    const next = page.render();
    if (!check) {
      writeFileSync(absolute, next);
      continue;
    }
    let current = "";
    try {
      current = readFileSync(absolute, "utf8");
    } catch {}
    if (current !== next) stale.push(page.file);
  }
  if (stale.length > 0) {
    console.error(`Stale generated reference: ${stale.join(", ")}. Run \`just gen\` and commit.`);
    process.exit(1);
  }
  console.log(check ? "Generated reference is current." : `Wrote ${pages.length} reference pages.`);
}

/** Link from a page in docs/reference to a repository path. */
function repoLink(label: string, repoPath: string): string {
  return `[${label}](../../${repoPath})`;
}

function generatedNote(source: string): string {
  return `Generated by \`just gen\` from ${source}. Edit the source, not this page; \`just docs-check\` fails when the page is stale.`;
}

function cell(text: string): string {
  return text.replaceAll("|", "\\|").replaceAll("\n", " ");
}

function code(text: string): string {
  return text.includes("`") ? `\`\` ${text} \`\`` : `\`${text}\``;
}

// ---------- config.yaml ----------

type JsonSchema = {
  readonly $ref?: string;
  readonly additionalProperties?: boolean | JsonSchema;
  readonly anyOf?: readonly JsonSchema[];
  readonly const?: unknown;
  readonly default?: unknown;
  readonly description?: string;
  readonly enum?: readonly unknown[];
  readonly exclusiveMinimum?: number;
  readonly items?: JsonSchema;
  readonly minLength?: number;
  readonly oneOf?: readonly JsonSchema[];
  readonly pattern?: string;
  readonly properties?: Readonly<Record<string, JsonSchema>>;
  readonly propertyNames?: JsonSchema;
  readonly required?: readonly string[];
  // A union of primitives is one schema whose type lists them.
  readonly type?: string | readonly string[];
};

function renderConfigReference(): string {
  const schema = createAutomationConfigJsonSchema() as JsonSchema;
  const sections: string[] = [];
  renderObjectSection(sections, "", schema);

  const enforcement = AUTOMATION_CONFIG_DECLARATIVE_FIELDS.map(
    (field) => `| ${code(field.path)} | ${code(field.status)} | ${cell(field.enforcement)} |`,
  ).join("\n");

  return `# config.yaml reference

${generatedNote(repoLink("`automationConfigRawSchema`", "packages/config/src/schema.ts"))} \`swizzle schema config\` prints the same contract as JSON Schema.

Every automation folder holds one \`config.yaml\`. The parser rejects any field this page does not list and names its path. Runnable examples live in [infra/examples](../../infra/examples/README.md).

${sections.join("\n\n")}

## Enforcement of declared fields

Some fields declare intent that only some execution modes enforce.

| Field | Status | Enforcement |
|---|---|---|
${enforcement}
`;
}

function renderObjectSection(sections: string[], objectPath: string, schema: JsonSchema): void {
  const properties = Object.entries(schema.properties ?? {});
  const required = new Set(schema.required ?? []);
  const heading = objectPath === "" ? "## Top-level fields" : `## ${code(objectPath)}`;
  const rows = properties.map(([name, property]) => {
    const fieldPath = joinPath(objectPath, name);
    return `| ${code(fieldPath)} | ${cell(describeType(property))} | ${required.has(name) ? "yes" : "no"} | ${cell(describeDefault(property))} | ${cell(describeField(property))} |`;
  });
  sections.push(
    `${heading}\n\n| Field | Type | Required | Default | Description |\n|---|---|---|---|---|\n${rows.join("\n")}`,
  );

  for (const [name, property] of properties) {
    const fieldPath = joinPath(objectPath, name);
    const union = variantUnion(property);
    if (union !== undefined) {
      for (const variant of union.variants) {
        renderObjectSection(
          sections,
          `${fieldPath} (${union.key}: ${variant.properties?.[union.key]?.const})`,
          variant,
        );
      }
    } else if (property.properties !== undefined) {
      renderObjectSection(sections, fieldPath, property);
    } else if (property.items?.properties !== undefined) {
      renderObjectSection(sections, `${fieldPath}[]`, property.items);
    }
  }
}

// A discriminated union such as `trigger` (on `type`) or `api_check` (on `mode`) is a `oneOf` of
// objects that share a constant property: each variant gets its own section.
function variantUnion(
  schema: JsonSchema,
): { readonly key: string; readonly variants: readonly JsonSchema[] } | undefined {
  const variants = schema.oneOf;
  const key = Object.keys(variants?.[0]?.properties ?? {}).find((name) =>
    variants?.every((variant) => variant.properties?.[name]?.const !== undefined),
  );
  return variants === undefined || key === undefined ? undefined : { key, variants };
}

function joinPath(parent: string, name: string): string {
  const base = parent.replace(/ \([a-z_]+: .*\)$/u, "");
  return base === "" ? name : `${base}.${name}`;
}

function describeType(schema: JsonSchema): string {
  if (schema.const !== undefined) return code(String(schema.const));
  if (schema.enum !== undefined) return schema.enum.map((value) => code(String(value))).join(" | ");
  if (schema.$ref !== undefined) return "JSON value";
  if (variantUnion(schema) !== undefined) return "object, one of the variants below";
  if (schema.anyOf !== undefined) {
    return schema.anyOf.map(describeType).join(" | ");
  }
  if (typeof schema.type === "object") {
    return schema.type.map((type) => describeType({ ...schema, type })).join(" | ");
  }
  switch (schema.type) {
    case "array":
      return `list of ${schema.items === undefined ? "values" : describeType(schema.items)}`;
    case "integer":
      return schema.exclusiveMinimum === 0 ? "positive integer" : "integer";
    case "object":
      if (schema.properties !== undefined) return "object";
      if (typeof schema.additionalProperties === "object") {
        return `map of ${describeType(schema.additionalProperties)}`;
      }
      return "object";
    case "string":
      return schema.pattern !== undefined
        ? `string matching ${code(schema.pattern)}`
        : schema.minLength === 1
          ? "non-empty string"
          : "string";
    default:
      return schema.type ?? "any";
  }
}

function describeDefault(schema: JsonSchema): string {
  if (schema.default === undefined || schema.properties !== undefined) return "-";
  return code(JSON.stringify(schema.default));
}

function describeField(schema: JsonSchema): string {
  const keyPattern = schema.propertyNames?.pattern;
  const keys = keyPattern === undefined ? "" : ` Keys match ${code(keyPattern)}.`;
  return `${schema.description ?? ""}${keys}`.trim();
}

// ---------- CLI ----------

type CommandDescriptor = ReturnType<typeof describeCommandTree>["commands"][number];
type OptionDescriptor = CommandDescriptor["options"][number];

function renderCliReference(): string {
  const program = createProgram();
  const tree = describeCommandTree(program);
  const sources = scanCommandSources();
  const sections = tree.commands.map((command) => renderCommand(command, 2, sources));

  return `# CLI reference

${generatedNote(repoLink("`createProgram`", "apps/cli/src/main.ts"))} \`swizzle commands --json\` prints the same tree as JSON, and \`swizzle <command> --help\` prints one command.

Commands print TOON on stdout, and \`--json\` prints the same data as one line of JSON. A failing command prints \`error\`, a stable \`code\` and \`help\`, its next steps, and exits non-zero (${repoLink("`AgentError`", "apps/cli/src/output.ts")}). \`swizzle schema error\` and \`swizzle schema exit-codes\` print that contract.

Protected API commands require a configured profile. Without one, they exit 4 with \`SIGN_IN_REQUIRED\` and the sign-in and token setup steps. The profile is the \`--profile\` flag, then \`SWIZZLE_PROFILE\`, then the default profile (${repoLink("`resolveProfile`", "apps/cli/src/profile.ts")}). The API URL is the \`--api-url\` flag, then the profile's URL. The environment is the \`-e\` flag, then the profile's \`env\`, then \`SWIZZLE_ENVIRONMENT\` (${repoLink("`resolveEnvironment`", "apps/cli/src/profile.ts")}). With no environment pinned, commands fail with \`ENVIRONMENT_NOT_PINNED\`. Local commands and public worker enrollment with a one-use code can run without a profile. Enrollment uses the API URL flag, a selected profile, or the local API default shown below.

## Global options

These options apply to every command.

${renderOptions(program.options.map(describeOption))}

${sections.join("\n\n")}
`;
}

function renderCommand(
  command: CommandDescriptor,
  level: number,
  sources: ReadonlyMap<string, string>,
): string {
  const heading = `${"#".repeat(Math.min(level, 4))} ${code(command.path.join(" "))}`;
  const source = sources.get(command.path[1] ?? "");
  const sourceLine =
    level === 2 && source !== undefined
      ? `\n\nSource: ${repoLink(path.basename(source), source)}`
      : "";
  const args = command.arguments
    .map((argument) => (argument.required ? `<${argument.name}>` : `[${argument.name}]`))
    .join(" ");
  const usage = `Usage: ${code(`${command.path.join(" ")}${args === "" ? "" : ` ${args}`}${command.options.length > 0 ? " [options]" : ""}`)}`;
  const parts = [`${heading}\n\n${command.description}${sourceLine}`];
  if (command.subcommands.length === 0 || command.options.length > 0) parts.push(usage);
  if (command.arguments.length > 0) {
    const rows = command.arguments.map(
      (argument) =>
        `| ${code(argument.name)} | ${argument.required ? "yes" : "no"} | ${cell(argument.description)} |`,
    );
    parts.push(`| Argument | Required | Description |\n|---|---|---|\n${rows.join("\n")}`);
  }
  if (command.options.length > 0) parts.push(renderOptions(command.options));
  if (command.examples.length > 0) parts.push(`\`\`\`bash\n${command.examples.join("\n")}\n\`\`\``);
  for (const subcommand of command.subcommands) {
    parts.push(renderCommand(subcommand, level + 1, sources));
  }
  return parts.join("\n\n");
}

function renderOptions(options: readonly OptionDescriptor[]): string {
  const rows = options.map((option) => {
    const fallback = option.defaultValue === null ? "-" : code(JSON.stringify(option.defaultValue));
    return `| ${code(option.flags)} | ${cell(option.description)} | ${cell(fallback)} |`;
  });
  return `| Option | Description | Default |\n|---|---|---|\n${rows.join("\n")}`;
}

/** Maps each top-level command to the file that registers it with `program.command("<name>")`. */
function scanCommandSources(): ReadonlyMap<string, string> {
  const sources = new Map<string, string>();
  for (const file of sourceFiles("apps/cli/src")) {
    const text = readFileSync(path.join(repoRoot, file), "utf8");
    for (const match of text.matchAll(/\bprogram\s*\.command\("([\w-]+)"/gu)) {
      sources.set(match[1] ?? "", file);
    }
  }
  return sources;
}

// ---------- API ----------

const ROUTE_METHODS = new Set([
  "get",
  "post",
  "put",
  "patch",
  "delete",
  "head",
  "options",
  "all",
  "route",
]);
const REFERENCE_METHODS = new Set(["get", "post", "put", "patch", "delete"]);
/** Files that register routes from a route table or constant instead of path literals: their POST paths. */
const TABLE_ROUTES: Readonly<Record<string, readonly string[]>> = {
  "apps/api/src/dispatch-routes.ts": Object.values(WORKER_ROUTES).map((route) => route.path),
  "apps/api/src/webhook-ingress.ts": [`${WEBHOOK_PATH_PREFIX}/*`],
};

function renderApiReference(): string {
  const routes: { method: string; route: string; file: string }[] = [];
  for (const file of sourceFiles("apps/api/src")) {
    const table = TABLE_ROUTES[file];
    for (const route of table ?? []) routes.push({ file, method: "POST", route });
    const text = readFileSync(path.join(repoRoot, file), "utf8");
    const source = ts.createSourceFile(file, text, ts.ScriptTarget.Latest, true);
    const visit = (node: ts.Node): void => {
      if (
        ts.isCallExpression(node) &&
        ts.isPropertyAccessExpression(node.expression) &&
        ts.isIdentifier(node.expression.expression) &&
        node.expression.expression.text === "app" &&
        ROUTE_METHODS.has(node.expression.name.text)
      ) {
        const method = node.expression.name.text;
        const route = node.arguments[0];
        if (table !== undefined && route !== undefined && !ts.isStringLiteral(route)) return;
        if (!REFERENCE_METHODS.has(method) || route === undefined || !ts.isStringLiteral(route)) {
          throw new Error(
            `${file} registers a route without app.<method>("<path>"; extend ${path.basename(fileURLToPath(import.meta.url))}.`,
          );
        }
        routes.push({ file, method: method.toUpperCase(), route: route.text });
      }
      ts.forEachChild(node, visit);
    };
    visit(source);
  }
  routes.sort((left, right) =>
    left.route === right.route
      ? left.method.localeCompare(right.method)
      : left.route.localeCompare(right.route),
  );
  const rows = routes.map((route) => {
    const access = ROUTE_ACCESS[`${route.method} ${route.route}`];
    if (access === undefined) throw new Error(`${route.method} ${route.route} has no access rule.`);
    return `| ${route.method} | ${code(route.route)} | ${access} | ${repoLink(path.basename(route.file), route.file)} |`;
  });

  return `# HTTP API reference

${generatedNote(`the route declarations in ${repoLink("apps/api/src", "apps/api/src/server.ts")}`)}

Each route's Access column is its rule in ${repoLink("`ROUTE_ACCESS`", "packages/runtime/src/http-contract.ts")}. A \`worker\` route always requires a live worker bearer token. Worker tokens cannot use control-plane routes. A \`session\` route requires a signed-in browser session. Other routes that are not \`public\` require a session cookie, an agent token, or a service account token. Agent tokens act with their person's current rights; service account tokens act in their account's project. An \`instance\` route also requires an instance owner or admin and otherwise returns HTTP 403 with \`ACCESS_DENIED\`. A \`resource\` route asks the access policy about the automation, run or project it names: one the caller may not read returns the same HTTP 404 as one that does not exist, and one the caller may read but not change returns HTTP 403 with \`ACCESS_DENIED\`, the role the change needs, the grants the caller holds, and the protected environment that capped the role (${repoLink("the security model", "docs/explanation/security-model.md")}). Lists and counts show only what the caller may read. Routes that take an \`environment\` query parameter default to the environment the API serves, its \`SWIZZLE_ENVIRONMENT\` (${repoLink("`getEnvironment`", "apps/api/src/http-shared.ts")}). Every \`GET\` route also answers \`HEAD\`.

Public error codes and their HTTP statuses come from ${repoLink("`API_ERROR_STATUS`", "packages/core/src/api-errors.ts")}. Control-plane error bodies contain \`code\`, \`error\` and \`message\`; \`code\` and \`error\` name the same catalogue entry. Framework client errors with an unknown code become HTTP 400 with \`REQUEST_INVALID\`. An empty body sent with \`Content-Type: application/json\` returns HTTP 400 with \`FST_ERR_CTP_EMPTY_JSON_BODY\`, and a JSON body containing the NUL character returns HTTP 400 with \`REQUEST_BODY_INVALID\`. Handler validation uses \`REQUEST_INVALID\`; automation configuration validation keeps \`AUTOMATION_CONFIG_INVALID\`.

Access writes report their outcome. A grant returns its role and \`previousRole\`, which is null for a new grant. Grant removal, protection and team membership return \`changed\`; removing protection also returns \`grantsRemoved\`. Project and service-account creation return \`changed\` beside the created or existing record. The CLI renders these results, including no-ops, without reading access state first. Deleting a project or removing protection with \`confirm=false\` requests confirmation before making a change.

Resource history routes return the same audit event envelope as \`GET /audit\`. Resource details are under \`change\`, and the common event id is \`id\`. Run responses use \`chainOriginRunId\` for chain grouping and deduplication and \`chainSourceRunIds\` for the immediate source runs.

After the auth check, each route checks its path parameters, query and JSON body against the shapes in ${repoLink("`request-validation.ts`", "apps/api/src/request-validation.ts")}: run, folder and rule ids are UUIDs, \`environment\` follows the environment name rule, secret names are uppercase environment variable names, and text from the URL has no control characters. A JSON body field must already have its declared type: the API converts no number, boolean or array to text. A request that does not match returns HTTP 400 with \`FST_ERR_VALIDATION\` before any lookup.

| Method | Path | Access | Source |
|---|---|---|---|
${rows.join("\n")}
`;
}

function sourceFiles(directory: string): string[] {
  return readdirSync(path.join(repoRoot, directory))
    .filter((name) => name.endsWith(".ts") && !name.endsWith(".test.ts"))
    .sort()
    .map((name) => `${directory}/${name}`);
}

main();
